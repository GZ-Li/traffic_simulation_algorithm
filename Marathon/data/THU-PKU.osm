  <tag k="alt_name" v="明珠"/>
  <tag k="building" v="yes"/>
  <tag k="description" v="清华大学校内水利枢纽，小水电站，雅称“明珠”。据谷兆祺回忆，苏联专家“看到二校门外校河水流清澈，流量不小，又有一点落差，乃建议在小河上修建一座水力枢纽，既作为教学示范，又利用泉水作一露天试验场。因此，由水工教研组年青教师自行设计，请永定河官厅工程局的干部工人来施工”，建成后的小电站“成为清华一景，领导都要看看，包括当时国家主席刘少奇同志。”曾进行过丰满水电站和新安江水电站的整体模型试验。"/>
  <tag k="name" v="水力枢纽"/>
  <tag k="plant:output:electricity" v="yes"/>
  <tag k="plant:source" v="hydro"/>
  <tag k="power" v="plant"/>
 </way>
