 <way id="1056034695" visible="true" version="3" changeset="169305293" timestamp="2025-07-22T17:19:48Z" user="phlinsia" uid="21973722">
  <nd ref="9703499931"/>
  <nd ref="9703499932"/>
  <nd ref="9703499933"/>
  <nd ref="9703499934"/>
  <nd ref="9703499931"/>
  <tag k="amenity" v="place_of_worship"/>
  <tag k="building" v="yes"/>
  <tag k="description" v="延寿寺位于东升镇前八家村，中国科学院生态环境研究中心西侧，双清大厦北面。现存的古建只有山门殿三间，坐南朝北，硬山筒瓦过垅脊。这座庙建于清康熙年间，是村庙，由合村公建。1928年时，有房殿21间，庙内有弥勒佛、十八罗汉、三大士、真武、四大天王、韦驮、四位娘娘、药王、土地、五道阎君等塑像，有铁磬六口。解放后一直被用作前八家小学直至2010年全村拆迁。山门殿北侧原有大殿及配殿，大殿后面为后罩房，院内有夹杆石，后罩房在1958年被拆，夹杆石在1966年被运走，大殿东北处有青砖和尚塔一座，“文革”初期被拆。"/>
  <tag k="name" v="延寿寺"/>
  <tag k="name:zh" v="延寿寺"/>
  <tag k="name:zh-Hans" v="延寿寺"/>
  <tag k="name:zh-Hant" v="延壽寺"/>
  <tag k="religion" v="buddhist"/>
 </way>
