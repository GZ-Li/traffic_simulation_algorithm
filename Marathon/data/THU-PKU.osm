 <node id="13267247602" visible="true" version="1" changeset="173934997" timestamp="2025-10-29T15:13:49Z" user="phlinsia" uid="21973722" lat="39.9952585" lon="116.3115873">
  <tag k="description" v="“燕东园”本指上世纪 20 年代美国教会大学燕京大学之东。1952 年之前，“燕东园”又名“东大地”，是燕京大学为自己的教师修建的宿舍（别墅区），一路之隔，稍早创立的清华大学的部分教授也在此居住。"/>
  <tag k="historic" v="yes"/>
  <tag k="name" v="东大地"/>
  <tag k="place" v="neighbourhood"/>
 </node>
